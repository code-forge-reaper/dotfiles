{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NovaScript",
  "scopeName": "source.nova",
  "fileTypes": ["nova"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#function_definitions" },
    { "include": "#namespace_definition" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#decorators" },
    { "include": "#using_stmt" },
    { "include": "#function_calls" },
    { "include": "#operators" },
    { "include": "#types" },
    { "include": "#custom_types" },
    { "include": "#enum_definition" },
    { "include": "#class" },
    { "include": "#identifiers" }      /* fallback — keep last */
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nova",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nova",
          "begin": "/\\*",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.nova" } },
          "end": "\\*/",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.nova" } },
          "patterns": [{ "match": "[\\s\\S]*", "name": "comment.block.nova" }]
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nova",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.nova" } },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.nova" } },
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.nova" }]
        },
        {
          "name": "string.quoted.single.nova",
          "begin": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.nova" } },
          "end": "'",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.nova" } },
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.nova" }]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.nova",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.character.unicode.nova",
          "match": "\\b0[uU][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.nova",
          "match": "\\b-?\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.nova",
          "match": "\\b(?:var|const|new|with|func|def|return|import|define)\\b"
        },
        {
          "name": "keyword.declaration.nova",
          "match": "\\bas\\b\\s+(\\w+)",
          "captures": { "1": { "name": "entity.name.label.nova" } }
        },
        {
          "name": "keyword.control.flow.nova",
          "match": "\\b(?:for|break|continue|foreach|while|until|do|in|end|else|elseif|if|test|failed|defer)\\b"
        },
        {
          "name": "storage.type.nova",
          "match": "\\b(?:string|number|function|bool|void)\\b"
        },
        {
          "name": "constant.language.nova",
          "match": "\\b(?:undefined|nil|NaN)\\b"
        }
      ]
    },

    "namespace_definition": {
      "patterns": [
        {
          "name": "keyword.declaration.nova",
          "match": "\\bscope\\b\\s+(\\w+)",
          "captures": { "1": { "name": "entity.name.namespace.nova" } }
        }
      ]
    },

    "using_stmt": {
      "patterns": [
        {
          "name": "meta.using.nova",
          "begin": "\\b(using)\\b\\s*(\\[|\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.declaration.nova" },
            "2": { "name": "punctuation.section.brackets.begin.nova" }
          },
          "end": "\\]|\\}",
          "patterns": [
            { "name": "entity.name.namespace.nova", "match": "([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)" },
            { "name": "punctuation.separator.comma.nova", "match": "\\s*,\\s*" },
            { "name": "text.whitespace.nova", "match": "\\s+" }
          ]
        },
        {
          "name": "keyword.declaration.nova",
          "match": "\\b(using)\\b\\s+([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)",
          "captures": {
            "1": { "name": "keyword.declaration.nova" },
            "2": { "name": "entity.name.namespace.nova" }
          }
        }
      ]
    },

    "function_definitions": {
      "patterns": [
        {
          "name": "keyword.declaration.function.nova",
          "match": "\\bfunc\\b\\s+(\\w+)",
          "captures": { "1": { "name": "entity.name.function.nova" } }
        }
      ]
    },

    "function_calls": {
      "patterns": [
        {
          "name": "entity.name.function.nova",
          "match": "\\b[a-zA-Z_]\\w*(?=\\s*\\()"
        }
      ]
    },

    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.nova",
          "match": "@(\\w+)",
          "captures": { "1": { "name": "entity.name.function.nova" } }
        }
      ]
    },

    "custom_types": {
      "patterns": [
        {
          "name": "keyword.declaration.nova",
          "match": "\\bdefine\\b\\s+(\\w+)",
          "captures": { "1": { "name": "entity.name.type.nova" } }
        }
      ]
    },

    "enum_definition": {
      "patterns": [
        {
          "name": "keyword.declaration.nova",
          "match": "\\benum\\b\\s+(\\w+)",
          "captures": { "1": { "name": "entity.name.type.nova" } }
        }
      ]
    },

    "builtins": {
      "patterns": [
        {
          "name": "constant.language.nova",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "keyword.declaration.nova",
          "match": "\\b(?:switch|strict|case|default)\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.nova",
          "match": "==|!=|<=|>=|\\+=|-=|\\*=|/=|&&|\\|\\||[=+\\-*/<>!]"
        },
        {
          "name": "punctuation.separator.nova",
          "match": "[\\(\\)\\[\\]\\{\\}\\.,:]"
        }
      ]
    },

    "class": {
      "patterns": [
        {
          "name": "keyword.declaration.nova",
          "match": "\\b(class|object|inherits|static|super)\\b"
        }
      ]
    },

    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.nova",
          "match": "\\b[a-zA-Z_]\\w*\\b"
        }
      ]
    }
  },
  "scope": "source.nova"
}
